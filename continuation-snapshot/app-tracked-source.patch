+.collection-card-copy > * { min-width: 0; max-width: 100%; white-space: normal; overflow-wrap: anywhere; }
+.collection-card-arrow { white-space: normal; overflow-wrap: anywhere; }
+.steampunk-ui__button { white-space: normal; overflow-wrap: anywhere; }
+.is-compact[data-state="landing"] .steampunk-ui__controls { grid-template-columns: minmax(0,1fr) auto; }
+.is-compact[data-state="landing"] .steampunk-ui__options-toggle {
+  border-color: transparent; background: none; color: #b8b9aa; min-width: 72px; min-height: 44px; padding-inline: 12px;
+}
+.is-compact[data-state="loading"] .steampunk-ui__hud:has(.steampunk-ui__loading-progress:not([hidden])) > .steampunk-ui__status,
+.is-compact[data-state="loading"] .steampunk-ui__helper { display: none; }
+@media(max-width:600px) {
+  .is-single-wall.is-compact[data-state="landing"] { padding: max(12px,env(safe-area-inset-top)) 20px max(18px,env(safe-area-inset-bottom)); }
+  .is-single-wall.is-compact[data-state="landing"] .steampunk-ui__top { padding-bottom: 10px; }
+  .is-single-wall.is-compact .collection-landing { padding-top: 32px; gap: 18px; margin: 0; }
+  .is-single-wall.is-compact[data-state="landing"] { justify-content: flex-start; }
+  .is-single-wall.is-compact .collection-title { font-size: clamp(36px,10vw,44px); }
+  .is-single-wall.is-compact .collection-intro { margin: 0; font-size: 13px; max-width: 32ch; line-height: 1.6; }
+  .is-single-wall.is-compact .collection-cards { grid-row: 3; }
+  .is-single-wall.is-compact[data-state="landing"] .steampunk-ui__dock { grid-row: 4; gap: 8px; }
+  .is-single-wall.is-compact .collection-share { grid-row: 5; }
+  .is-single-wall.is-compact .collection-share-body { gap: 12px; }
+  .is-single-wall.is-compact .collection-share img { height: 132px; }
+  .is-single-wall.is-compact .collection-card-image { aspect-ratio: 2.26; max-height: none; }
+  .is-single-wall.is-compact .collection-camera-note { font-size: 10px; text-align: left; }
+  .is-single-wall.is-compact[data-state="landing"] [data-control="start"] { min-height: 50px; }
+}
